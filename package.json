{
  "name": "@winnerhang/claude-adapter",
  "version": "1.0.2",
  "description": "Anthropic Claude Messages API 到 OpenAI Chat Completions API 兼容接口的本地适配代理",
  "main": "dist/claude-adapter/server.js",
  "bin": {
    "claude-adapter": "dist/claude-adapter/cli.js"
  },
  "files": [
    "dist/claude-adapter/**/*.js",
    "dist/claude-adapter/build-mode.json",
    "!dist/claude-adapter/**/*.test.js",
    "claude-adapter.config.example.json",
    "README.md"
  ],
  "scripts": {
    "start": "node src/local-proxy/index.js",
    "dev": "node --watch src/local-proxy/index.js",
    "build": "npm run adapter:build --",
    "adapter:start": "node dist/claude-adapter/cli.js start",
    "adapter:start:src": "tsx src/claude-adapter/cli.ts run",
    "adapter:dev": "tsx watch src/claude-adapter/cli.ts run",
    "adapter:build": "tsc -p tsconfig.claude-adapter.json && chmod +x dist/claude-adapter/cli.js && node scripts/write-claude-adapter-build-mode.mjs",
    "adapter:test": "npm run adapter:build && node --test dist/claude-adapter/**/*.test.js",
    "prepublishOnly": "npm run adapter:test"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "socks": "^2.8.3",
    "undici": "^7.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT"
}
